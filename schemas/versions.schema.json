{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kanasjnr/midnight-cast/v0.2.2/schemas/versions.schema.json",
  "title": "versions and matrix data",
  "type": "object",
  "required": [
    "network",
    "matrixUpdated",
    "matrixStale",
    "expected",
    "live",
    "checks",
    "allOk"
  ],
  "properties": {
    "network": {
      "type": "string"
    },
    "matrixUpdated": {
      "type": "string"
    },
    "matrixStale": {
      "type": "boolean"
    },
    "docUrl": {
      "type": "string"
    },
    "expected": {
      "type": "object",
      "required": [
        "node",
        "runtimeSpec",
        "indexerApi"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "minNode": {
          "type": "string"
        },
        "minNodeReason": {
          "type": "string",
          "description": "Why a node older than minNode falls short"
        },
        "runtimeSpec": {
          "type": "integer"
        },
        "ledger": {
          "type": "string"
        },
        "indexer": {
          "type": "string"
        },
        "indexerApi": {
          "type": "string"
        },
        "proofServer": {
          "type": "string"
        },
        "onChainRuntime": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "live": {
      "type": "object",
      "required": [
        "nodeVersion",
        "runtimeSpecVersion"
      ],
      "properties": {
        "nodeVersion": {
          "type": "string"
        },
        "runtimeSpecVersion": {
          "type": "integer"
        },
        "runtimeImplVersion": {
          "type": "integer"
        },
        "indexerProtocolVersion": {
          "type": "integer"
        },
        "indexerApi": {
          "type": "string"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "ok"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "expected": {
            "type": "string"
          },
          "live": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "localPackageChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "ok"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "expected": {
            "type": "string"
          },
          "live": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "allOk": {
      "type": "boolean"
    },
    "matrixSource": {
      "type": "object",
      "required": [
        "kind",
        "updated"
      ],
      "properties": {
        "kind": {
          "enum": [
            "override",
            "upstream",
            "cache",
            "bundled"
          ]
        },
        "updated": {
          "type": "string"
        },
        "ageMinutes": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "matrixNotes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Inconsistencies inside Midnight's published matrix for this network"
    },
    "localProject": {
      "type": "object",
      "required": [
        "dir",
        "packageJson"
      ],
      "properties": {
        "dir": {
          "type": "string"
        },
        "packageJson": {
          "type": "boolean"
        }
      },
      "description": "Where local packages were looked for, and whether a package.json was there"
    },
    "examples": {
      "$ref": "examples-verdict.schema.json"
    },
    "examplesToolchain": {
      "type": "object",
      "description": "The project against the toolchain Midnight's examples are pinned to. Advice beside the support-matrix checks: it doesn't change allOk or the exit code.",
      "required": [
        "repo",
        "commit",
        "ledger",
        "toolchain",
        "checks"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "ledger": {
          "type": "string",
          "description": "The ledger the examples' code targets"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "expected",
              "live",
              "ok"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "live": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "note": {
          "type": "string",
          "description": "Why the project isn't compared, when the network runs another ledger than the examples' code; checks is then empty"
        },
        "upgrade": {
          "type": "object",
          "description": "When the project's midnight-js is a major version behind the examples, on a network that runs their ledger: the pull request that moved the examples there, and what it changed in the example closest to the project",
          "required": [
            "pr",
            "title",
            "url",
            "example",
            "files"
          ],
          "properties": {
            "pr": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "example": {
              "type": "string",
              "description": "The example that shares a contract file name with the project, or hello-world"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "url"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "description": "The file's diff in the pull request"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
