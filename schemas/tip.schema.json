{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Kanasjnr/midnight-cast/main/schemas/tip.schema.json",
  "title": "tip data",
  "type": "object",
  "required": [
    "network",
    "rpcHeight",
    "indexerHeight",
    "delta",
    "threshold",
    "inSync"
  ],
  "properties": {
    "rpcHeight": {
      "type": "integer"
    },
    "indexerHeight": {
      "type": "integer"
    },
    "delta": {
      "type": "integer"
    },
    "threshold": {
      "type": "integer"
    },
    "inSync": {
      "type": "boolean"
    },
    "network": {
      "type": "string"
    }
  }
}
