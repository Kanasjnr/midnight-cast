{
  "name": "midnight-cast",
  "version": "0.1.6",
  "description": "Read-only developer CLI for Midnight: network health, indexer queries, error decoding",
  "author": "Kanasjnr",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kanasjnr/midnight-cast.git"
  },
  "homepage": "https://github.com/Kanasjnr/midnight-cast#readme",
  "bugs": {
    "url": "https://github.com/Kanasjnr/midnight-cast/issues"
  },
  "bin": {
    "mn": "dist/cli.js",
    "midnight-cast": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && tsx scripts/copy-data.ts",
    "cli": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run test/integration.test.ts",
    "test:smoke": "INTEGRATION=1 vitest run",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "live-check": "tsx scripts/live-check.ts",
    "error-codes": "tsx scripts/error-code-parity.ts",
    "examples-reports": "tsx scripts/examples-reports.ts",
    "examples-index": "tsx scripts/examples-index.ts",
    "fixtures": "tsx scripts/record-fixtures.ts",
    "smoke:tarball": "tsx scripts/smoke-tarball.ts",
    "agent-files": "tsx scripts/agent-files.ts",
    "binaries": "tsx scripts/build-binaries.ts",
    "smoke:binary": "tsx scripts/smoke-binary.ts"
  },
  "keywords": [
    "midnight",
    "cli",
    "blockchain",
    "indexer"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/server": "^2.3.0",
    "commander": "^13.1.0",
    "graphql-ws": "^6.0.4",
    "ws": "^8.18.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "ajv": "^8.20.0",
    "graphql": "^16.14.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
